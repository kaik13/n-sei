+#include <pthread.h>
@@ -14,0 +16,19 @@ typedef struct cleanup_s {
+/* Guard both the global and per-ELF arrays: guest threads can register C++
+ * destructors concurrently. Never hold this lock while invoking guest code.
+ * Synchronize fork so a child cannot inherit a half-updated allocation. */
+static pthread_mutex_t cleanup_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t cleanup_once = PTHREAD_ONCE_INIT;
+static void cleanup_atfork_prepare(void) { pthread_mutex_lock(&cleanup_mutex); }
+static void cleanup_atfork_parent(void) { pthread_mutex_unlock(&cleanup_mutex); }
+static void cleanup_atfork_child(void) { pthread_mutex_unlock(&cleanup_mutex); }
+static void cleanup_init_atfork(void)
+{
+    pthread_atfork(cleanup_atfork_prepare, cleanup_atfork_parent, cleanup_atfork_child);
+}
+static void cleanup_lock(void)
+{
+    pthread_once(&cleanup_once, cleanup_init_atfork);
+    pthread_mutex_lock(&cleanup_mutex);
+}
+static void cleanup_unlock(void) { pthread_mutex_unlock(&cleanup_mutex); }
+
