{
  "name": "bloco-bedrock-panel",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1",
    "build:android": "bash scripts/build-mobile-android.sh",
    "package:release": "node scripts/package-mobile-release.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/outfit": "^5.2.7",
    "archiver": "^8.0.0",
    "dockerode": "^5.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1",
    "vite": "^6.3.5",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "^4.0.0"
    }
  }
}
